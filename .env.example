# Export these in your shell. No automatic .env loading.
REPLY_MODEL=llama3.2
REPLY_EVALUATOR_MODEL=llama3.2
REPLY_OLLAMA_HOST=http://127.0.0.1:11434
REPLY_MEMORY_PATH=private/memory
REPLY_RETRIEVAL_LIMIT=4
REPLY_STYLE_CHARS=6000
REPLY_CONTEXT_CHARS=16000
REPLY_THREAD_LIMIT=8
REPLY_ATTEMPTS=3
REPLY_TEMPERATURE=0.2
REPLY_SEED=42
REPLY_CREDENTIALS_PATH=lib/cred/credentials.json
REPLY_TOKEN_PATH=lib/cred/token.json
REPLY_BACKEND_TOKEN_PATH=private/backend-token
REPLY_EXTENSION_ORIGIN=chrome-extension://REPLACE_WITH_EXTENSION_ID
REPLY_PORT=8765
# Local inbox dashboard (inbox pages include read and unread messages)
REPLY_DASHBOARD_LIMIT=100
REPLY_DASHBOARD_REFRESH_SECONDS=60
REPLY_DASHBOARD_QUERY=
